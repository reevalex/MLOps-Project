.PHONY: pipeline split validate train evaluate serve monitor test lint fmt

pipeline: split validate train evaluate

split:
	uv run python -m src.data.split_dataset --config params.yaml

validate:
	uv run python -m src.data.validate_data --config params.yaml

train:
	uv run python -m src.models.train --config params.yaml

evaluate:
	uv run python -m src.models.evaluate --config params.yaml

serve:
	uv run uvicorn src.serving.app:app --reload --host 0.0.0.0 --port 8000

monitor:
	uv run python -m src.monitoring.monitor --config params.yaml

lint:
	ruff check src

fmt:
	ruff format src
	ruff check src --fix

test:
	pytest -q

mlflow:
	mlflow ui --backend-store-uri mlruns --port 5000